# Groq API key for AI quotes and captions — https://console.groq.com/keys
# (Users can also paste their own key in the web app's Settings.)
GROQ_API_KEY=
# Default model. See https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-120b
# Allowed frontend origins (JSON list)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
